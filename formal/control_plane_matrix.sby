[tasks]
d1_p
d1_c
d3np_p
d3np_c
mp3_p
mp3_c
cwb_p
cwb_c
dr_p
dr_c

[options]
d1_p: mode prove
d1_p: depth 18
d1_c: mode cover
d1_c: depth 22
d3np_p: mode prove
d3np_p: depth 18
d3np_c: mode cover
d3np_c: depth 22
mp3_p: mode prove
mp3_p: depth 18
mp3_c: mode cover
mp3_c: depth 22
cwb_p: mode prove
cwb_p: depth 18
cwb_c: mode cover
cwb_c: depth 22
dr_p: mode prove
dr_p: depth 18
dr_c: mode cover
dr_c: depth 22

[engines]
smtbmc yices

[script]
read_verilog -sv -formal -DFORMAL outstanding_tracker.sv credit_manager.sv admission_top.sv config_ctrl.sv control_plane_top.sv formal_control_plane.sv
# five selected instances (NOT a Cartesian product): each prove + cover.
d1_p:   chparam -set N_POOLS 1 -set AMT_W 2 -set COUNT_W 3 -set RESET_MAX 2 -set DEPTH 1 -set GEN_W 1 formal_control_plane
d1_c:   chparam -set N_POOLS 1 -set AMT_W 2 -set COUNT_W 3 -set RESET_MAX 2 -set DEPTH 1 -set GEN_W 1 formal_control_plane
d3np_p: chparam -set N_POOLS 2 -set AMT_W 2 -set COUNT_W 4 -set RESET_MAX 3 -set DEPTH 3 -set GEN_W 2 formal_control_plane
d3np_c: chparam -set N_POOLS 2 -set AMT_W 2 -set COUNT_W 4 -set RESET_MAX 3 -set DEPTH 3 -set GEN_W 2 formal_control_plane
mp3_p:  chparam -set N_POOLS 3 -set AMT_W 2 -set COUNT_W 4 -set RESET_MAX 3 -set DEPTH 2 -set GEN_W 2 formal_control_plane
mp3_c:  chparam -set N_POOLS 3 -set AMT_W 2 -set COUNT_W 4 -set RESET_MAX 3 -set DEPTH 2 -set GEN_W 2 formal_control_plane
cwb_p:  chparam -set N_POOLS 2 -set AMT_W 2 -set COUNT_W 3 -set RESET_MAX 3 -set DEPTH 2 -set GEN_W 2 formal_control_plane
cwb_c:  chparam -set N_POOLS 2 -set AMT_W 2 -set COUNT_W 3 -set RESET_MAX 3 -set DEPTH 2 -set GEN_W 2 formal_control_plane
dr_p:   chparam -set N_POOLS 2 -set AMT_W 3 -set COUNT_W 5 -set RESET_MAX 6 -set DEPTH 2 -set GEN_W 2 formal_control_plane
dr_c:   chparam -set N_POOLS 2 -set AMT_W 3 -set COUNT_W 5 -set RESET_MAX 6 -set DEPTH 2 -set GEN_W 2 formal_control_plane
prep -top formal_control_plane

[files]
rtl/core/outstanding_tracker.sv
rtl/core/credit_manager.sv
rtl/core/admission_top.sv
rtl/csr/config_ctrl.sv
rtl/core/control_plane_top.sv
formal/formal_control_plane.sv
